@using Microsoft.Extensions.Localization
@using System.Globalization
@using BlazorServerFirstProject.Services
@inject IStringLocalizer<SharedResources> L
@inject AnalyticsService Analytics
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <!-- Aplica o tema salvo antes da primeira pintura, pra tela de carregamento e o prerender já nascerem no tema certo -->
    <script>
        (function () {
            function syncTheme() {
                try {
                    var theme = localStorage.getItem('theme');
                    var dark = theme === 'dark' || ((!theme || theme === 'system') && window.matchMedia('(prefers-color-scheme: dark)').matches);
                    if (document.documentElement.classList.contains('dark') !== dark)
                        document.documentElement.classList.toggle('dark', dark);
                } catch (e) { }
            }
            syncTheme();

            // A navegação aprimorada do Blazor (ex.: "Enviar Outra Mensagem" no /contact) copia pro <html> os
            // atributos que o servidor manda, e o servidor não sabe o tema (fica no localStorage), então a classe
            // "dark" sumia. O observador devolve a classe antes da próxima pintura, sem piscar.
            new MutationObserver(syncTheme).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
        })();
    </script>
    <link rel="stylesheet" href="@Assets["css/theme.css"]" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="icon" type="image/png" href="favicon.svg" />
    <!-- Mesmo modo do Routes: sem isso o <PageTitle> das páginas interativas não atualiza o título da aba ao navegar -->
    <HeadOutlet @rendermode="PageRenderMode" />
    @if (Analytics.Enabled)
    {
        <!-- Cloudflare Web Analytics: sem cookie; "spa" conta também as trocas de página feitas pelo Blazor sem recarregar -->
        <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon="@AnalyticsBeaconConfig"></script>
    }
</head>

<body class="bg-ghibli-white dark:bg-ghibli-black">
    <!-- LOADING: sobreposição fixa que cobre a página enquanto o circuito do Blazor conecta.
         Antes era um bloco comum no fluxo da página e nada o removia, então ficava parado no topo pra sempre.
         Página estática (como /contact) não tem circuito pra esperar, então não mostra o loading. -->
    @if (PageRenderMode is not null)
    {
    <div id="blazor-loading" class="bg-ghibli-white text-ghibli-black fixed inset-0 z-[100] flex items-center justify-center transition-opacity duration-500 dark:bg-ghibli-black dark:text-ghibli-white">
        <div class="text-center">
            <img src="favicon.svg" class="mx-auto w-28 animate-bounce" alt="logo" />
            <p class="font-montserrat mt-4 text-lg">@L["LoadingText"]</p>
        </div>
    </div>
    }

    <!-- O teu Router / Routes. Interativo em todas as páginas, menos nas marcadas com [ExcludeFromInteractiveRouting] -->
    <Routes @rendermode="PageRenderMode" />

    <!-- Scroll fluido da rodinha; carrega antes do Blazor pra já envolver o history.pushState que o router usa -->
    <script src="@Assets["js/smooth-scroll.js"]"></script>

    <!-- autostart=false pra iniciar o Blazor manualmente e saber quando o circuito ficou pronto -->
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script>
        // Chamada pelo MainLayout no primeiro render interativo, que é quando o circuito realmente está pronto
        window.ghibliHideLoading = function () {
            var loading = document.getElementById('blazor-loading');
            if (!loading) return;
            loading.style.opacity = '0';
            setTimeout(function () { loading.remove(); }, 500);
        };

        Blazor.start().catch(window.ghibliHideLoading);

        // Rede de segurança: se a conexão demorar demais, libera a página prerenderizada mesmo assim
        setTimeout(window.ghibliHideLoading, 8000);
    </script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Páginas com [ExcludeFromInteractiveRouting] (como o /contact, que precisa de POST HTTP de verdade pro
    // rate limit e o antiforgery funcionarem) ficam estáticas (SSR); o resto do site segue interativo
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;

    private string AnalyticsBeaconConfig =>
        System.Text.Json.JsonSerializer.Serialize(new { token = Analytics.Token, spa = true });
}
