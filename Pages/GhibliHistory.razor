        new("Disney", "Era4", TimelineKind.Event, null),
        new("Mononoke", "Era4", TimelineKind.Film, "images/princess_mononoke.webp"),
        new("Yamadas", "Era5", TimelineKind.Film, null),
        new("SpiritedAway", "Era5", TimelineKind.Film, "images/spirited_away.jpg"),
        new("Museum", "Era5", TimelineKind.Event, null),
        new("CatReturns", "Era5", TimelineKind.Film, null),
