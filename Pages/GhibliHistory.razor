        new("MiyazakiBorn", "Era1", TimelineKind.Event, "images/hayao_miyazaki.jpeg"),
        new("Okayama", "Era1", TimelineKind.Event, null),
        new("Mother", "Era1", TimelineKind.Event, null),
        new("Hakujaden", "Era1", TimelineKind.Event, null),
        new("TakahataToei", "Era1", TimelineKind.Event, null),
        new("MiyazakiToei", "Era1", TimelineKind.Event, null),
        new("Union", "Era1", TimelineKind.Event, null),
        new("Otsuka", "Era1", TimelineKind.Figure, null),
        new("Horus", "Era1", TimelineKind.Film, null),
        new("Pero", "Era1", TimelineKind.Event, null),
        new("Pippi", "Era2", TimelineKind.Event, null),
        new("Panda", "Era2", TimelineKind.Event, null),
        new("Heidi", "Era2", TimelineKind.Event, null),
        new("Marco", "Era2", TimelineKind.Event, null),
        new("Conan", "Era2", TimelineKind.Event, null),
        new("Suzuki", "Era2", TimelineKind.Figure, "images/toshio_suzuki.jpg"),
        new("Cagliostro", "Era2", TimelineKind.Film, null),
        new("Chie", "Era2", TimelineKind.Event, null),
        new("NausicaaManga", "Era3", TimelineKind.Event, null),
        new("Tokuma", "Era3", TimelineKind.Figure, "images/yasuyoshi_tokuma.webp"),
        new("NausicaaFilm", "Era3", TimelineKind.Film, null),
        new("Founding", "Era3", TimelineKind.Event, "images/Studio_Ghibli.svg"),
        new("Laputa", "Era4", TimelineKind.Film, null),
        new("Yanagawa", "Era4", TimelineKind.Event, null),
        new("Totoro", "Era4", TimelineKind.Film, "images/my_neighbor_totoro.jpg"),
        new("Kiki", "Era4", TimelineKind.Film, null),
