        new("Return", "Era7", TimelineKind.Event, null),
        new("TakahataDies", "Era7", TimelineKind.Event, "images/isao_takahata.jpg"),
        new("Earwig", "Era7", TimelineKind.Film, null),
        new("Park", "Era7", TimelineKind.Event, null),
        new("Heron", "Era7", TimelineKind.Film, "images/the_boy_and_the_heron.jpg"),
        new("Palme", "Era7", TimelineKind.Event, null),
    };

    // Filme: marco azul. Figura importante: marco vazado. Evento: marco na cor do texto.
    private static string MarkerClass(TimelineKind kind) => kind switch
    {
        TimelineKind.Film => "bg-ghibli-sky",
        TimelineKind.Figure => "bg-ghibli-white border-[3px] border-ghibli-sky dark:bg-ghibli-black",
        _ => "bg-ghibli-black dark:bg-ghibli-white"
    };

    // O logo em SVG é preto e não pode ser cortado, então fica inteiro e inverte no tema escuro
    private static string ImageClass(string image) => image.EndsWith(".svg")
        ? "object-contain p-4 dark:invert"
        : "aspect-[3/4] object-cover dark:brightness-90";
}
