@page "/films"
@using BlazorServerFirstProject.Models
@using BlazorServerFirstProject.Services
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> L
@inject FilmCatalogService Catalog

<PageTitle>@L["FilmsPageTitle"]</PageTitle>

<section class="text-ghibli-black pb-20 dark:text-ghibli-white">
    <!-- Cabeçalho no mesmo padrão das outras páginas -->
    <div class="flex items-start justify-center py-14">
        <div class="border-ghibli-black w-[60vw] border-b-[3px] lg:w-[30vw] dark:border-ghibli-white">
        </div>
    </div>
    <div class="flex flex-col items-center gap-8 px-8 pb-12">
        <h1 class="font-ghibli-lemon-milk text-center text-2xl md:text-4xl">@L["FilmsPageTitle"]</h1>
        <p class="font-montserrat text-md w-full md:w-[60vw] lg:w-[45vw] lg:text-xl">@L["FilmsIntro"]</p>
    </div>

    <!-- Controles: modo de exibição, ordenação e filtros -->
    <div class="font-ghibli-lemon-milk mx-auto flex max-w-6xl flex-wrap items-end justify-center gap-x-8 gap-y-5 px-8 pb-14 text-sm md:text-base">
        <div class="flex flex-col gap-2">
            <span class="text-ghibli-grey text-xs">@L["FilmsViewLabel"]</span>
            <div class="border-ghibli-black flex overflow-hidden rounded-2xl border-2 dark:border-ghibli-white">
                <button type="button" class="@ToggleClass(_view == FilmsView.Detailed) px-4 py-2 transition-colors duration-300" @onclick="() => _view = FilmsView.Detailed">@L["FilmsViewDetailed"]</button>
                <button type="button" class="@ToggleClass(_view == FilmsView.Posters) px-4 py-2 transition-colors duration-300" @onclick="() => _view = FilmsView.Posters">@L["FilmsViewPosters"]</button>
            </div>
        </div>

        <div class="flex flex-col gap-2">
            <label for="films-sort" class="text-ghibli-grey text-xs">@L["FilmsSortLabel"]</label>
            <div class="flex gap-2">
                <select id="films-sort" @bind="_sort"
                        class="font-ghibli-lemon-milk border-ghibli-black bg-ghibli-white rounded-2xl border-2 px-3 py-2 dark:bg-ghibli-black dark:border-ghibli-white">
                    <option value="@FilmsSort.Release">@L["FilmsSortRelease"]</option>
                    <option value="@FilmsSort.Critics">@L["FilmsSortCritics"]</option>
                    <option value="@FilmsSort.Audience">@L["FilmsSortAudience"]</option>
                </select>
                <button type="button"
                        class="border-ghibli-black rounded-2xl border-2 px-4 py-2 transition-colors duration-300 hover:bg-ghibli-black hover:text-ghibli-white dark:border-ghibli-white dark:hover:bg-ghibli-white dark:hover:text-ghibli-black"
                        @onclick="() => _descending = !_descending">
                    @(_descending ? "↓ " + L["FilmsSortDescending"] : "↑ " + L["FilmsSortAscending"])
                </button>
            </div>
        </div>

        <div class="font-montserrat flex flex-col gap-2 pb-1">
            @if (_view == FilmsView.Posters)
            {
                <label class="flex cursor-pointer items-center gap-2">
                    <input type="checkbox" class="accent-ghibli-sky h-4 w-4" @bind="_showNames" />
                    @L["FilmsShowNames"]
                </label>
            }
            <label class="flex cursor-pointer items-center gap-2">
                <input type="checkbox" class="accent-ghibli-sky h-4 w-4" @bind="_showRelated" />
                @L["FilmsShowRelated"]
            </label>
        </div>
    </div>

    @RenderGroup(FilmGroup.Ghibli)

    @if (_showRelated)
    {
        <div class="mx-auto flex max-w-3xl flex-col items-center gap-4 px-8 pt-24 pb-12 text-center">
            <div class="border-ghibli-black mb-6 w-[60vw] border-b-[3px] lg:w-[30vw] dark:border-ghibli-white"></div>
            <h2 class="font-ghibli-lemon-milk text-2xl md:text-3xl">@L["FilmsSectionRelated"]</h2>
            <p class="font-montserrat text-md lg:text-lg">@L["FilmsSectionRelatedIntro"]</p>
        </div>
        @RenderGroup(FilmGroup.Related)
    }
</section>

<Footer />

@code {
    private enum FilmsView { Detailed, Posters }
    private enum FilmsSort { Release, Critics, Audience }

    private List<FilmView> _films = new();
    private bool _loaded = false;

    // Padrões pedidos: lista detalhada, ordem de lançamento crescente, nomes visíveis no modo capas
    private FilmsView _view = FilmsView.Detailed;
    private FilmsSort _sort = FilmsSort.Release;
    private bool _descending = false;
    private bool _showNames = true;
    private bool _showRelated = false;

    protected override void OnInitialized()
    {
        // Mostra o catálogo na hora; capas da API e notas chegam depois do primeiro render
        _films = Catalog.GetBaseList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await Catalog.EnrichAsync(_films);
        _loaded = true;
        StateHasChanged();
    }

    private IEnumerable<FilmView> Sorted(FilmGroup group)
    {
        var films = _films.Where(f => f.Definition.Group == group);

        // Filme sem nota vai sempre para o fim, independente da direção
        IOrderedEnumerable<FilmView> ordered = _sort switch
        {
            FilmsSort.Critics => films.OrderBy(f => f.CriticScore is null).ThenBy(f => _descending ? -(f.CriticScore ?? 0) : f.CriticScore ?? 0),
            FilmsSort.Audience => films.OrderBy(f => f.AudienceScore is null).ThenBy(f => _descending ? -(f.AudienceScore ?? 0) : f.AudienceScore ?? 0),
            _ => _descending ? films.OrderByDescending(f => f.Definition.Released) : films.OrderBy(f => f.Definition.Released)
        };

        return ordered.ThenBy(f => f.Definition.Released);
    }

    private RenderFragment RenderGroup(FilmGroup group) => __builder =>
    {
        if (_view == FilmsView.Detailed)
        {
            <div class="mx-auto flex max-w-5xl flex-col gap-12 px-6 md:px-10">
                @foreach (var film in Sorted(group))
                {
                    @DetailedCard(film)
                }
            </div>
        }
        else
        {
            <div class="mx-auto grid max-w-7xl grid-cols-2 gap-x-4 gap-y-8 px-6 sm:grid-cols-3 md:grid-cols-4 md:px-10 lg:grid-cols-5 xl:grid-cols-6">
                @foreach (var film in Sorted(group))
                {
                    @PosterCard(film)
                }
            </div>
        }
    };

    // Card grande, no mesmo estilo do carrossel da Home, mas em lista
    private RenderFragment DetailedCard(FilmView film) => __builder =>
    {
        var slug = film.Definition.Slug;
        <article class="flex flex-col overflow-hidden rounded-2xl shadow-lg md:flex-row dark:ring-1 dark:ring-ghibli-white/15">
            <div class="aspect-[2/3] w-full shrink-0 md:w-72 lg:w-80">
                @Poster(film, "h-full w-full object-cover dark:brightness-90")
            </div>
            <div class="flex flex-1 flex-col gap-4 p-6 lg:p-8">
                <div class="flex flex-col gap-1">
                    <h2 class="font-ghibli-lemon-milk text-2xl lg:text-3xl">@L[$"Film_{slug}_Title"]</h2>
                    <p class="font-montserrat text-ghibli-grey text-sm lg:text-base">
                        @film.Definition.Released.Year &middot; @L["FilmsDirectedBy"] @film.Definition.Director
                        @if (film.RuntimeMinutes is not null)
                        {
                            <span> &middot; @film.RuntimeMinutes min</span>
                        }
                    </p>
                </div>
                <p class="font-montserrat text-md leading-relaxed lg:text-lg">@L[$"Film_{slug}_Synopsis"]</p>
                @if (film.Definition.NotStudioProduction)
                {
                    <p class="font-montserrat text-ghibli-grey border-ghibli-sky border-l-2 pl-3 text-sm italic">@L["FilmsNausicaaNote"]</p>
                }
                <div class="mt-auto flex flex-wrap items-center gap-x-8 gap-y-3 pt-2">
                    <div class="flex items-center gap-3">
                        <div class="@MetacriticClass(film.CriticScore) flex h-12 w-12 items-center justify-center rounded-lg text-xl font-bold text-ghibli-black">
                            @ScoreText(film.CriticScore?.ToString())
                        </div>
                        <p class="font-ghibli-lemon-milk text-lg">METACRITIC</p>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="relative flex h-14 w-14 items-center justify-center">
                            <svg class="text-imdb-star absolute inset-0 h-full w-full dark:text-imdb-star-dark" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path d="M16.926 20.2a1 1 0 0 1-.466-.115l-4.471-2.352-4.471 2.348a1 1 0 0 1-1.451-1.054l.854-4.98L3.3 10.521a1 1 0 0 1 .555-1.706l5-.727 2.237-4.531A1 1 0 0 1 11.989 3a1 1 0 0 1 .9.558l2.236 4.53 5 .727a1 1 0 0 1 .555 1.706l-3.618 3.527.854 4.98a1 1 0 0 1-.99 1.172z" />
                            </svg>
                            <span class="text-ghibli-black relative z-10 text-lg font-bold">@ScoreText(film.AudienceScore?.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))</span>
                        </div>
                        <p class="font-ghibli-lemon-milk text-lg">IMDB</p>
                    </div>
                </div>
            </div>
        </article>
    };

    // Card de capa, no estilo Letterboxd.
    // Com "Exibir nomes" ligado, o nome fica abaixo da capa; desligado, sobe de dentro da capa no hover.
    private RenderFragment PosterCard(FilmView film) => __builder =>
    {
        var title = L[$"Film_{film.Definition.Slug}_Title"];
        <figure class="group">
            <div class="relative aspect-[2/3] overflow-hidden rounded-lg shadow-md ring-1 ring-ghibli-black/10 dark:ring-ghibli-white/15" tabindex="0" title="@title">
                @Poster(film, "h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 dark:brightness-90")

                @if (_sort != FilmsSort.Release && _loaded)
                {
                    <span class="font-ghibli-lemon-milk bg-ghibli-black/75 text-ghibli-white absolute top-2 right-2 rounded-md px-2 py-0.5 text-xs">
                        @(_sort == FilmsSort.Critics ? ScoreText(film.CriticScore?.ToString()) : ScoreText(film.AudienceScore?.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)))
                    </span>
                }

                @if (!_showNames)
                {
                    <div class="text-ghibli-white absolute inset-x-0 bottom-0 translate-y-full bg-linear-to-t from-black/90 via-black/60 to-transparent px-3 pt-10 pb-3 transition-transform duration-300 ease-out group-hover:translate-y-0 group-focus-within:translate-y-0">
                        <p class="font-ghibli-lemon-milk text-sm leading-tight">@title</p>
                        <p class="font-montserrat text-xs opacity-80">@film.Definition.Released.Year</p>
                    </div>
                }
            </div>
            @if (_showNames)
            {
                <figcaption class="mt-2 flex flex-col gap-0.5">
                    <span class="font-ghibli-lemon-milk text-sm leading-tight">@title</span>
                    <span class="font-montserrat text-ghibli-grey text-xs">@film.Definition.Released.Year</span>
                </figcaption>
            }
        </figure>
    };

    private RenderFragment Poster(FilmView film, string cssClass) => __builder =>
    {
        if (film.Poster is not null)
        {
            // Se a imagem falhar (link quebrado na OMDb, por exemplo), cai no placeholder com o nome
            <img src="@film.Poster" alt="@L[$"Film_{film.Definition.Slug}_Title"]" class="@cssClass" loading="lazy" draggable="false"
                 @onerror="() => film.Poster = null" />
        }
        else
        {
            // Enquanto a capa não chega (ou se nenhuma fonte tiver), mantém o formato 2:3 com o nome no meio
            <div class="@(_loaded ? "" : "animate-pulse") bg-ghibli-sky/20 font-ghibli-lemon-milk flex h-full w-full items-center justify-center p-4 text-center text-sm">
                @L[$"Film_{film.Definition.Slug}_Title"]
            </div>
        }
    };

    private string ScoreText(string? value) => value ?? (_loaded ? "N/A" : "…");

    private static string MetacriticClass(int? score) => score switch
    {
        null => "bg-ghibli-grey/30",
        >= 61 => "bg-metacritic-green dark:bg-metacritic-green-dark",
        >= 40 => "bg-metacritic-yellow",
        _ => "bg-metacritic-red"
    };

    private static string ToggleClass(bool active) => active
        ? "bg-ghibli-black text-ghibli-white dark:bg-ghibli-white dark:text-ghibli-black"
        : "hover:bg-ghibli-black/10 dark:hover:bg-ghibli-white/10";
}
