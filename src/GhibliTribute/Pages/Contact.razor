@page "/contact"
@* Página estática (SSR): o formulário faz um POST HTTP normal, e aí o rate limit por IP e o antiforgery
   do ASP.NET funcionam. Pelo circuito interativo (WebSocket) eles não atuam. *@
@attribute [ExcludeFromInteractiveRouting]
@using System.Globalization
@using System.Net.Mail
@using System.Text.RegularExpressions
@using GhibliTribute.Components.SVGs
@using GhibliTribute.Services
@using Microsoft.AspNetCore.DataProtection
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> L
@inject TurnstileService Turnstile
@inject ContactEmailService Email
@inject IDataProtectionProvider DataProtection
@inject IConfiguration Configuration
@inject NavigationManager Navigation

<PageTitle>@L["ContactPageTitle"]</PageTitle>

<section class="text-ghibli-black pb-20 dark:text-ghibli-white">
    <div class="flex items-start justify-center py-14">
        <div class="border-ghibli-black w-[60vw] border-b-[3px] lg:w-[30vw] dark:border-ghibli-white">
        </div>
    </div>
    <h1 class="font-ghibli-lemon-milk pb-6 text-center text-2xl md:text-4xl">@L["ContactPageTitle"]</h1>
    <p class="font-montserrat mx-auto max-w-2xl px-8 pb-14 text-center text-base lg:text-lg">@L["ContactIntro"]</p>

    <div class="mx-auto grid max-w-6xl gap-14 px-8 md:grid-cols-[3fr_2fr] md:gap-16">
        <!-- Formulário -->
        <div>
            @if (Status == "sent")
            {
                <div class="border-ghibli-sky flex flex-col items-start gap-5 rounded-2xl border-2 p-8">
                    <p class="font-ghibli-lemon-milk text-xl md:text-2xl">@L["ContactSentTitle"]</p>
                    <p class="font-montserrat text-base lg:text-lg">@L["ContactSentText"]</p>
                    <a href="contact" class="@OutlineButtonClass">@L["ContactSendAnother"]</a>
                </div>
            }
            else
            {
                @if (_notice is not null)
                {
                    <p role="alert" class="font-montserrat mb-6 rounded-2xl border-2 border-red-600 px-5 py-3 text-red-700 dark:border-red-400 dark:text-red-300">@_notice</p>
                }

                <form method="post" @formname="contact" @onsubmit="SubmitAsync" id="contact-form" class="relative flex flex-col gap-6">
                    <AntiforgeryToken />
                    <input type="hidden" name="Input.RenderedAt" value="@_renderedAt" />

                    <!-- Honeypot: fora da tela e fora da ordem de tabulação. Gente não vê nem preenche; robô preenche tudo -->
                    <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
                        <label>Website <input type="text" name="Input.Website" tabindex="-1" autocomplete="off" /></label>
                    </div>

                    <div class="flex flex-col gap-2">
                        <label for="contact-name" class="font-ghibli-lemon-milk text-lg">@L["ContactName"]</label>
                        <input id="contact-name" type="text" name="Input.Name" value="@Input!.Name" required maxlength="@NameMax" autocomplete="name" class="@FieldClass" />
                        <FieldError Message="@ErrorFor(nameof(ContactInput.Name))" />
                    </div>

                    <div class="flex flex-col gap-2">
                        <label for="contact-email" class="font-ghibli-lemon-milk text-lg">@L["ContactEmail"]</label>
                        <input id="contact-email" type="email" name="Input.Email" value="@Input.Email" required maxlength="@EmailMax" autocomplete="email" class="@FieldClass" />
                        <FieldError Message="@ErrorFor(nameof(ContactInput.Email))" />
                    </div>

                    <div class="flex flex-col gap-2">
                        <label for="contact-subject" class="font-ghibli-lemon-milk text-lg">@L["ContactSubject"]</label>
                        <select id="contact-subject" name="Input.Subject" class="@FieldClass dark:bg-ghibli-black cursor-pointer">
                            @foreach (var subject in Subjects)
                            {
                                <option value="@subject" selected="@(Input.Subject == subject)">@SubjectLabel(subject)</option>
                            }
                        </select>
                    </div>

                    <div class="flex flex-col gap-2">
                        <label for="contact-message" class="font-ghibli-lemon-milk text-lg">@L["ContactMessage"]</label>
                        <textarea id="contact-message" name="Input.Message" rows="7" required maxlength="@MessageMax" class="@FieldClass resize-y">@Input.Message</textarea>
                        <FieldError Message="@ErrorFor(nameof(ContactInput.Message))" />
                    </div>

                    @if (!string.IsNullOrEmpty(Turnstile.SiteKey))
                    {
                        <!-- Renderizado pelo contact.js, que escolhe o tema claro/escuro do site -->
                        <div id="contact-turnstile" data-sitekey="@Turnstile.SiteKey" data-language="@TurnstileLanguage"></div>
                    }

                    <button type="submit" data-sending="@L["ContactSending"]" class="@ButtonClass disabled:cursor-wait disabled:opacity-60">@L["ContactSend"]</button>
                    <p class="font-montserrat text-ghibli-grey text-sm dark:text-neutral-400">@L["ContactPrivacyNote"] <a href="privacy" class="text-ghibli-sky underline hover:text-ghibli-sky-hover">@L["PrivacyPageTitle"]</a>.</p>
                </form>
            }
        </div>

        <!-- Links diretos, pra quem prefere não preencher nada -->
        <aside class="flex flex-col gap-6">
            <h2 class="font-ghibli-lemon-milk text-xl md:text-2xl">@L["ContactOrReachMe"]</h2>

            @if (!string.IsNullOrWhiteSpace(PublicEmail))
            {
                <div class="flex flex-wrap items-center gap-3">
                    <EmailIcon CssClass="@IconClass" />
                    <a href="mailto:@PublicEmail" class="font-montserrat text-base break-all hover:underline lg:text-lg">@PublicEmail</a>
                    <button type="button" data-copy="@PublicEmail" data-copied="@L["ContactCopied"]"
                            class="font-montserrat border-ghibli-black cursor-pointer rounded-xl border-2 px-3 py-1 text-sm transition-colors duration-300 hover:bg-ghibli-black hover:text-ghibli-white dark:border-ghibli-white dark:hover:bg-ghibli-white dark:hover:text-ghibli-black">
                        <span data-copy-label>@L["ContactCopy"]</span>
                    </button>
                </div>
            }

            <ul class="font-montserrat flex flex-col gap-5 text-base lg:text-lg">
                <li><a href="https://www.linkedin.com/in/jo%C3%A3o-vitor-ventura-b2777626a/" target="_blank" rel="noopener noreferrer" class="@LinkClass"><LinkedinIcon CssClass="@IconClass" />LinkedIn</a></li>
                <li><a href="https://github.com/AFCVentura" target="_blank" rel="noopener noreferrer" class="@LinkClass"><GitHubIcon CssClass="@IconClass" />GitHub</a></li>
                <li><a href="https://www.upwork.com/freelancers/~01a8ad836ef3bdc75e" target="_blank" rel="noopener noreferrer" class="@LinkClass"><UpworkIcon CssClass="@IconClass" />Upwork</a></li>
                <li><a href="https://jventura.dev" target="_blank" rel="noopener noreferrer" class="@LinkClass"><WebsiteIcon CssClass="@IconClass" />jventura.dev</a></li>
            </ul>
        </aside>
    </div>
</section>

<Footer />

<script src="@Assets["js/contact.js"]"></script>
@if (Status != "sent" && !string.IsNullOrEmpty(Turnstile.SiteKey))
{
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=ghibliTurnstileLoad" async defer></script>
}

@code {
    private const int NameMax = 100;
    private const int EmailMax = 254;
    private const int MessageMax = 2000;
    private static readonly string[] Subjects = ["freelance", "job", "other"];

    // Menos que isso entre abrir a página e enviar, só um robô consegue
    private static readonly TimeSpan MinimumFillTime = TimeSpan.FromSeconds(3);

    [SupplyParameterFromForm]
    private ContactInput? Input { get; set; }

    [SupplyParameterFromQuery]
    private string? Status { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private readonly Dictionary<string, string> _errors = new();
    private string? _notice;
    private string _renderedAt = "";

    private string? PublicEmail => Configuration["Contact:PublicEmail"];
    private static string TurnstileLanguage => CultureInfo.CurrentUICulture.Name == "pt-BR" ? "pt-br" : "en";

    // Guarda a hora em que o formulário foi aberto, assinada (o visitante não consegue forjar) e com validade
    private ITimeLimitedDataProtector Protector =>
        DataProtection.CreateProtector("Contact.RenderedAt").ToTimeLimitedDataProtector();

    protected override void OnInitialized()
    {
        Input ??= new();
        _renderedAt = Protector.Protect(DateTimeOffset.UtcNow.ToUnixTimeMilliseconds().ToString(), TimeSpan.FromHours(2));
        _notice = Status switch
        {
            "too-many" => L["ContactTooMany"].Value,
            "expired" => L["ContactExpired"].Value,
            _ => null
        };
    }

    private async Task SubmitAsync()
    {
        // Robô: preencheu o honeypot ou enviou rápido demais. Finge que deu certo pra não ensinar nada a ele
        var elapsed = ElapsedSinceRender(Input!.RenderedAt);
        if (!string.IsNullOrEmpty(Input.Website) || elapsed < MinimumFillTime)
        {
            Navigation.NavigateTo("contact?status=sent");
            return;
        }

        // Assinatura inválida ou vencida: página aberta há mais de 2 horas, ou o servidor reiniciou e trocou as chaves
        if (elapsed is null)
        {
            _notice = L["ContactExpired"];
            return;
        }

        if (!Validate())
            return;

        var token = HttpContext.Request.Form["cf-turnstile-response"].ToString();
        if (!await Turnstile.VerifyAsync(token, HttpContext.Connection.RemoteIpAddress?.ToString()))
        {
            _notice = L["ContactCaptchaFailed"];
            return;
        }

        var sent = await Email.SendAsync(new ContactMessage(Input.Name!, Input.Email!, SubjectLabel(Input.Subject!), Input.Message!));
        if (!sent)
        {
            _notice = L["ContactSendFailed"];
            return;
        }

        // Redireciona depois do POST: recarregar a página de sucesso não reenvia a mensagem
        Navigation.NavigateTo("contact?status=sent");
    }

    private bool Validate()
    {
        _errors.Clear();

        // Caracteres de controle (quebra de linha etc.) não têm lugar em nome, e iriam parar no assunto do e-mail
        Input!.Name = Regex.Replace(Input.Name ?? "", @"\p{C}+", " ").Trim();
        Input.Email = (Input.Email ?? "").Trim();
        Input.Message = (Input.Message ?? "").Trim();
        if (!Subjects.Contains(Input.Subject))
            Input.Subject = "other";

        if (Input.Name.Length == 0)
            _errors[nameof(ContactInput.Name)] = L["ContactNameRequired"];
        else if (Input.Name.Length > NameMax)
            _errors[nameof(ContactInput.Name)] = L["ContactNameTooLong"];

        if (Input.Email.Length == 0)
            _errors[nameof(ContactInput.Email)] = L["ContactEmailRequired"];
        else if (Input.Email.Length > EmailMax || !MailAddress.TryCreate(Input.Email, out var address) || address.Address != Input.Email)
            _errors[nameof(ContactInput.Email)] = L["ContactEmailInvalid"];

        if (Input.Message.Length == 0)
            _errors[nameof(ContactInput.Message)] = L["ContactMessageRequired"];
        else if (Input.Message.Length > MessageMax)
            _errors[nameof(ContactInput.Message)] = L["ContactMessageTooLong"];

        return _errors.Count == 0;
    }

    private TimeSpan? ElapsedSinceRender(string? renderedAt)
    {
        try
        {
            var milliseconds = long.Parse(Protector.Unprotect(renderedAt!));
            return DateTimeOffset.UtcNow - DateTimeOffset.FromUnixTimeMilliseconds(milliseconds);
        }
        catch (Exception)
        {
            return null;
        }
    }

    private string? ErrorFor(string field) => _errors.GetValueOrDefault(field);

    private string SubjectLabel(string subject) => subject switch
    {
        "freelance" => L["ContactSubjectFreelance"],
        "job" => L["ContactSubjectJob"],
        _ => L["ContactSubjectOther"]
    };

    public class ContactInput
    {
        public string? Name { get; set; }
        public string? Email { get; set; }
        public string? Subject { get; set; }
        public string? Message { get; set; }
        public string? Website { get; set; }
        public string? RenderedAt { get; set; }
    }

    private const string FieldClass = "font-montserrat border-ghibli-black w-full rounded-2xl border-2 bg-transparent px-4 py-2.5 text-base outline-none transition-colors duration-300 focus:border-ghibli-sky dark:border-ghibli-white dark:focus:border-ghibli-sky";
    private const string ButtonClass = "font-ghibli-lemon-milk bg-ghibli-black text-ghibli-white w-fit cursor-pointer rounded-2xl px-5 py-2.5 text-center text-lg transition-all duration-500 hover:bg-ghibli-white hover:text-ghibli-black active:bg-ghibli-white active:text-ghibli-black md:text-xl dark:text-ghibli-black dark:bg-ghibli-white dark:hover:bg-ghibli-black dark:hover:text-ghibli-white";
    private const string OutlineButtonClass = "font-ghibli-lemon-milk border-ghibli-black w-fit cursor-pointer rounded-2xl border-2 px-5 py-2 text-center text-lg transition-all duration-500 hover:bg-ghibli-black hover:text-ghibli-white md:text-xl dark:border-ghibli-white dark:hover:bg-ghibli-white dark:hover:text-ghibli-black";
    private const string LinkClass = "flex w-fit items-center gap-3 transition-colors duration-300 hover:text-ghibli-sky";
    private const string IconClass = "h-7 w-7 shrink-0";
}
